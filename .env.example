# ==============================================================================
# ORACLE DATABASE CONNECTION SETTINGS
# ==============================================================================
# Configure with your Oracle Database (e.g., Oracle XE, Enterprise, Cloud Autonomous)
# python-oracledb operates in Thin mode by default (no Oracle Instant Client required).

ORACLE_USER=admin
ORACLE_PASSWORD=your_secure_password_here
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
# Optional: Alternative connect string (e.g. for TNS / EZConnect)
# ORACLE_DSN=localhost:1521/XEPDB1

# ==============================================================================
# DEMONSTRATION & RUNTIME CONFIGURATION
# ==============================================================================
# Set to True to allow the application to fallback to local simulated demonstration
# dataset when Oracle server is not reachable. Oracle remains the primary DB.
ALLOW_DEMO_MODE=True

# ML Hyperparameters Default
ML_CONTAMINATION=0.08
ML_RANDOM_STATE=42
DBSCAN_EPS=0.5
DBSCAN_MIN_SAMPLES=5

# Severity & Score Weights (JSON format or numerical floats)
WEIGHT_HIGH_SEVERITY=1.0
WEIGHT_MEDIUM_SEVERITY=0.6
WEIGHT_LOW_SEVERITY=0.2

